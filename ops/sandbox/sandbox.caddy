# Sandbox entrance (docs/sandbox/plan.md, ## Netz and ## Verbindung), imported by exactly one line of /etc/caddy/Caddyfile.
# The block of wa-staging stays untouched; no global option here.

# Control API for the control plane: only the payment server may pass, everybody else gets 403. Certificate from Let's Encrypt,
# the name has an A record without proxy and without AAAA.
ctl.sbx.postyourprice.com {
	@payment remote_ip 76.13.144.207
	handle @payment {
		reverse_proxy 127.0.0.1:8730
	}
	handle {
		respond "forbidden" 403
	}
}

# Exposed sandbox ports under a domain of their own, never under the zone of the payment service (goals/sandbox/07), through
# the Cloudflare proxy. The zone runs SSL mode Full (strict): Cloudflare checks this origin against the Origin CA certificate in
# /etc/caddy/sbx/, which ops/sandbox/setup.sh --origin-cert puts there (0600, owner caddy); certificate and key never enter the
# repo. The site name already pins the domain, so the matcher only checks the label. sandboxd answers 404 for every name it does
# not know, so no sandbox shows up under an arbitrary name of the zone.
*.sandboxhost.dev {
	tls /etc/caddy/sbx/origin.pem /etc/caddy/sbx/origin.key
	@sandbox header_regexp Host ^sbx-[a-z0-9]{1,11}-[0-9]{1,5}\.
	handle @sandbox {
		reverse_proxy 127.0.0.1:8731 {
			header_up Host {host}
		}
	}
	handle {
		respond "not found" 404
	}
}
