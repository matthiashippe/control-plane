#!/usr/bin/env bash
# automaton-supervise: keeps the runtime at the pin running in a sandbox (goals/sandbox/08, decision 1).
#
# At most one per sandbox (pidfile $H/.automaton/supervise.pid; while that process lives this one exits 0). Runs
# `node /opt/automaton/dist/index.js --run` with HOME=$H, output appended to $H/.automaton/run.log, and after every end
# one log line and a new start 5 s later. Before every start a run.log over 10 MB is cut to its last 5 MB. It never ends
# by itself; it stops when the mark $H/.automaton/autostart is gone.
set -u

H="${AUTOMATON_HOME:-/root}"
export HOME="$H"
DIR="$H/.automaton"
LOG="$DIR/run.log"
PIDFILE="$DIR/supervise.pid"
RUNTIME_DIR="${AUTOMATON_RUNTIME_DIR:-/opt/automaton}"
RESTART_S="${AUTOMATON_RESTART_S:-5}"
LOG_MAX=10485760
LOG_KEEP=5242880

mkdir -p "$DIR"
if [ -f "$PIDFILE" ]; then
  old=$(cat "$PIDFILE" 2>/dev/null || true)
  # The pidfile outlives a container restart and pids repeat in a fresh container, so only a living supervisor counts.
  if [[ $old =~ ^[0-9]+$ ]] && [ "$old" != "$$" ] && kill -0 "$old" 2>/dev/null \
     && tr '\0' ' ' < "/proc/$old/cmdline" 2>/dev/null | grep -q automaton-supervise; then
    exit 0
  fi
fi
echo "$$" > "$PIDFILE"

while [ -f "$DIR/autostart" ]; do
  size=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
  if [ "$size" -gt "$LOG_MAX" ]; then
    tail -c "$LOG_KEEP" "$LOG" > "$LOG.cut" && mv -f "$LOG.cut" "$LOG"
  fi
  (cd "$RUNTIME_DIR" && exec node "$RUNTIME_DIR/dist/index.js" --run) >> "$LOG" 2>&1
  code=$?
  echo "automaton-supervise: runtime exited with $code, restart in $RESTART_S s" >> "$LOG"
  sleep "$RESTART_S"
done
rm -f "$PIDFILE"
