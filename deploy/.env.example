# /opt/control-plane/.env auf der VM (chmod 600). Werte hier sind Beispiele, keine Secrets.

# Provisionierung: der Runtime-Client sendet die SIWE-Domain "conway.tech" fest.
CP_SIWE_DOMAIN=conway.tech

# Topup: Wallet, die die USDC-Zahlungen empfängt (Base Mainnet), und Tiers.
CP_PAY_TO=0x914102284463F4F58B1D2f6DB9aC80BFcaA7d614
CP_NETWORK=base
# Tier 1 nur für die Abnahme; danach wieder auf die Runtime-Tiers zurück.
CP_TOPUP_TIERS_USD=1,5,25,100,500,1000,2500

# Settlement über externen Facilitator (kein eigenes On-Chain-Senden im Betrieb).
CP_SETTLER=facilitator
CP_FACILITATOR_URL=https://facilitator.payai.network
# CP_FACILITATOR_AUTH=Bearer ...   (nur CDP)

# Inferenz-Einkauf.
CP_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
CP_OPENROUTER_MODELS=openai/gpt-5.2,openai/gpt-5-mini
# CP_MODEL_ALIASES leer lassen: der OpenRouter-Provider liefert gpt-5.2 und gpt-5-mini als Aliase.
