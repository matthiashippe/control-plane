# cp.hippe.eu bleibt, damit nichts bricht, was heute darauf zeigt: die Issue-Kommentare, das
# x402-Manifest der bisherigen Zahlungen, die veroeffentlichten CC0-Daten. Welche der beiden
# Adressen die kanonische ist, entscheidet CP_PUBLIC_URL im Dienst, nicht diese Zeile.
cp.hippe.eu, postyourprice.com {
	encode zstd gzip

	# Ohne Limit nimmt der Dienst beliebig grosse Bodies an; /v1/auth/nonce antwortete auf 3 MB
	# Muell mit 200. 1 MB ist reichlich: der groesste echte Request ist ein Inferenz-Prompt.
	request_body {
		max_size 1MB
	}

	header {
		# Der Dienst nimmt Zahlungen entgegen, also nie wieder ueber Klartext.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Die Seite laedt nichts von aussen. Das Inline-Script ist per Hash erlaubt, damit
		# 'unsafe-inline' nicht noetig ist. Aendert sich das Skript, muss der Hash mit.
		Content-Security-Policy "default-src 'none'; script-src 'sha256-4SRH5WazXeAcUMwLFvCY4lXOlcCFv/p0qFFiElgkhKE='; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy cp:8402 {
		# x402 und Inferenz können lange dauern; Caddy soll nicht vor dem Control Plane abbrechen.
		transport http {
			response_header_timeout 180s
		}
	}
	log {
		# Zwei Ziele: stdout für `docker compose logs`, Datei für alles, was einen Neustart des
		# Containers überleben muss. Ohne die Datei ist die Zugriffshistorie nach jedem
		# Caddy-Deploy weg, und genau dann braucht man sie.
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		# X-Payment enthält eine gültige EIP-3009-Signatur. Caddy redigiert von sich aus nur
		# Authorization, deshalb hier ausdrücklich. Solange die Nonce on-chain unverbraucht ist,
		# ist so ein Header verwertbar.
		format filter {
			wrap json
			fields {
				request>headers>X-Payment delete
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>uri query {
					delete brief
				}
			}
		}
	}
}

# www gehoert nicht neben die nackte Domain, sondern darauf. Zwei Adressen mit identischem Inhalt
# teilen jedes Suchmaschinen-Signal auf, und der Umweg kostet einen Redirect, den kein Mensch
# bemerkt. 308 und nicht 301: die Methode bleibt erhalten, was fuer die POST-Endpunkte unter /v1
# der Unterschied zwischen einer Weiterleitung und einem verlorenen Request ist.
www.postyourprice.com {
	redir https://postyourprice.com{uri} 308
}
